# NorieMusic server configuration.
# Copy this file to server/.env, replace every placeholder, then restart the server.
# NEVER commit server/.env. This example file contains no real secrets.

# --- Core server -------------------------------------------------------------
NODE_ENV=production
PORT=8787
HOST=127.0.0.1

# Required in production. Use a random value of at least 32 characters.
MUSIC_SESSION_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Directories are resolved relative to the server/ folder when left relative.
MUSIC_DIR=./music
DATA_DIR=./data
WEB_DIST=../apps/web/dist

SESSION_DAYS=30
SECURE_COOKIES=true
ALLOW_REGISTRATION=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://music.norie.app,http://localhost:5174,http://127.0.0.1:5174

SCAN_ON_START=true
MAX_SCAN_FILES=50000

# Playlist limits (also enforced by the import endpoint).
MAX_PLAYLISTS_PER_ACCOUNT=1000
MAX_PLAYLIST_TRACKS=10000

# --- Spotify Web API ---------------------------------------------------------
# Get these from https://developer.spotify.com/dashboard after creating an app.
# Leave both blank to disable official Spotify Web API features.
# The server still supports the existing yt-dlp/oEmbed fallback for playlist
# metadata, and the app never downloads Spotify audio.
# Note: Spotify may deny GET /playlists/{id}/tracks (HTTP 403) for client-
# credentials apps. Official metadata works; imports use the fallback and
# preserve every reference rather than silently dropping tracks.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify rejects search limits above 10 for this app; keep this at 10 or less.
SPOTIFY_SEARCH_LIMIT=10

# Verify after restart:
#   curl http://127.0.0.1:8787/api/auth/status
#   => spotifyEnabled: true
#   curl -H "Cookie: Norie_session=..." "http://127.0.0.1:8787/api/spotify/search?q=test"
# A 503 means the credentials are missing; a 502 means Spotify rejected the
# credentials or the request. Metadata is not audio permission.

# --- MySQL (optional mirror/backup) ------------------------------------------
# DB_DRIVER=sqlite (default) keeps SQLite authoritative.
# DB_DRIVER=mysql selects MySQL only after the connection and migration are verified.
DB_DRIVER=sqlite
# NorieMusic stays on SQLite as the authoritative database while DB_DRIVER=sqlite.
# If MYSQL_HOST and MYSQL_USER are set, the server initializes the MySQL schema
# and mirrors users, tracks, playlists, external import tracks, favorites,
# listening history, settings, and artist follows on startup.
# MySQL is NOT the primary database yet; the app does not read from MySQL.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=norie_music
#
# Verified local setup (Windows, MariaDB 13.0):
# - The dedicated account MUST use mysql_native_password; mysql2 cannot
#   negotiate auth_gssapi_client / parsec. Create it like:
#     CREATE USER 'norie'@'127.0.0.1' IDENTIFIED VIA mysql_native_password
#       USING PASSWORD('<generated password>');
#     CREATE DATABASE norie_music CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL PRIVILEGES ON norie_music.* TO 'norie'@'127.0.0.1';
# - The schema requires InnoDB key lengths <= 3072 bytes with utf8mb4:
#   tracks.path is VARCHAR(700) and album indexes use 150-char prefixes.

# Create the database/user before starting the server, for example:
#   CREATE DATABASE norie_music CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'norie'@'127.0.0.1' IDENTIFIED BY 'change-this-password';
#   GRANT ALL PRIVILEGES ON norie_music.* TO 'norie'@'127.0.0.1';
#   FLUSH PRIVILEGES;
#
# Verify after restart:
#   server log: "MySQL bağlantısı kuruldu (...)"
#   curl http://127.0.0.1:8787/api/auth/status
#   => mysqlEnabled: true
# Switching primaries from SQLite to MySQL requires a separate migration;
# do not delete server/data/library.db until that migration is verified.
