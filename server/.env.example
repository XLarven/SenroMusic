# Norie Music v0.4 — login/register auth + opsiyonel Supabase
# Copy to .env and set a strong MUSIC_SESSION_SECRET before exposing the server.
PORT=8787
HOST=127.0.0.1
# Legacy master-key (optional, acil giriş). Yeni kurulumda boş bırakılabilir.
MUSIC_TOKEN=
MUSIC_SESSION_SECRET=change-this-to-a-random-secret-at-least-32-chars
MUSIC_DIR=./music
DATA_DIR=./data
SESSION_DAYS=30
# Set to true when the app is served over HTTPS.
SECURE_COOKIES=false
# Yeni kayıtlara izin verilsin mi? true/false
ALLOW_REGISTRATION=true
# Supabase (opsiyonel) — bkz. SUPABASE-SETUP.md
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCAN_ON_START=true
