# Copy this file to .env and change the token before exposing the server.
PORT=8787
HOST=0.0.0.0
MUSIC_TOKEN=change-this-to-a-long-random-string
MUSIC_DIR=./music
DATA_DIR=./data
SESSION_DAYS=30
# Set to true when the app is served over HTTPS.
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCAN_ON_START=true
