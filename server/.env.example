# Norie Music v0.6 — e-posta/parola auth + MySQL senkronu (SQLite aynası)
PORT=8787
HOST=127.0.0.1
MUSIC_SESSION_SECRET=change-this-to-a-random-secret-at-least-32-chars
MUSIC_DIR=./music
DATA_DIR=./data
SESSION_DAYS=30
# Set to true when the app is served over HTTPS (Cloudflare Tunnel).
SECURE_COOKIES=true
ALLOW_REGISTRATION=true
# MySQL (opsiyonel ama önerilir) — bkz. mysql/schema.sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=norie
MYSQL_PASSWORD=change-mysql-password
MYSQL_DATABASE=norie_music
CORS_ORIGINS=https://music.norie.app
SCAN_ON_START=true
