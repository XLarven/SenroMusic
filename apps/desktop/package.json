{
  "name": "@Norie/desktop",
  "version": "0.15.0",
  "private": true,
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis",
    "build:win": "electron-builder --win nsis portable",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:all": "electron-builder --win nsis portable --mac dmg --linux AppImage deb"
  },
  "build": {
    "appId": "com.Norie Music.desktop",
    "productName": "Norie Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../web/public/icon-512.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.music",
      "icon": "../web/public/icon-512.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Audio",
      "icon": "../web/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
