{
  "name": "@senro/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.senromusic.desktop",
    "productName": "SenroMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../web/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
